# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldurun.
# `.env` dosyası .gitignore'da olduğu için asla repoya girmez.

DJANGO_DEBUG=True
# Production için güçlü bir anahtar üretin:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
