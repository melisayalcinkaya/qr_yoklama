# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldurun.
# `.env` dosyası .gitignore'da olduğu için asla repoya girmez.

# Yerel geliştirme için True; canlı ortamda mutlaka False.
DJANGO_DEBUG=True

# Production için güçlü bir anahtar üretin:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Canlıda tam adresle: https://yoklama.ornek.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Boş bırakılırsa SQLite kullanılır.
# DATABASE_URL=postgres://kullanici:sifre@localhost:5432/qr_yoklama

# Yalnızca HTTPS sağlamayan bir ortamda test ederken False yapın.
# DJANGO_SECURE_SSL_REDIRECT=True
